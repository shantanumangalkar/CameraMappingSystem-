# =========================================================
# Backend Environment Variables — Police Camera Mapping
# Copy this file to .env and fill in your production values
# This file is safe to commit — it contains NO real secrets
# =========================================================

# --- Spring Profile ---
# Use 'dev' for local development (enables seeder, Swagger, show-sql)
# Use 'prod' for production (strict mode)
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8088

# --- PostgreSQL / Supabase Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-database
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_strong_database_password_here

# --- JWT Security ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=generate_a_strong_256bit_hex_secret_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Supabase Storage (for camera media uploads) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# --- JPA DDL Auto (use 'validate' or 'none' in production) ---
JPA_DDL_AUTO=validate

# --- Swagger / OpenAPI (set to 'true' ONLY in dev/staging) ---
SWAGGER_ENABLED=false
