
# =========================================================
# Frontend Environment Variables — Police Camera Mapping
# Copy this file to .env and fill in your values
# =========================================================

# Backend API base URL (for production deployments)
# In dev, Vite proxies /api -> http://localhost:8088 automatically
VITE_API_URL=https://your-backend-domain.com/api/v1

# Application name shown in title/branding
VITE_APP_NAME=Police Camera Mapping System
